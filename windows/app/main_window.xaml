<Window x:Class="limenamer.MAIN_WINDOW"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:limenamer"
        xmlns:vm="clr-namespace:limenamer;assembly=limenamer_view_model"
        Title="LimeNamer"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="visible_when" />
        <local:EQUALS_CONVERTER x:Key="equals" />
        <x:Static x:Key="duplicate_formats" Member="vm:MAIN_VIEW_MODEL.duplicate_format_choices" />
        <x:Static x:Key="duplicate_modes" Member="vm:MAIN_VIEW_MODEL.duplicate_mode_choices" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <DockPanel x:Name="toolbar" Grid.Row="0" Margin="8,0" LastChildFill="False"
                   IsEnabled="{Binding can_edit}">
            <StackPanel x:Name="toolbar_right" DockPanel.Dock="Right" Orientation="Horizontal"
                        VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.ContextMenu>
                        <ContextMenu x:Name="theme_menu" Opened="theme_menu_opened" />
                    </StackPanel.ContextMenu>
                    <Button Style="{StaticResource split_main_button}" Click="theme_click"
                            ToolTip="{x:Static vm:STRINGS.toolbar_theme}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource icon_text}" Text="&#xE790;" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource split_drop_button}" Click="open_menu_click"
                            ToolTip="{x:Static vm:STRINGS.toolbar_theme_menu}">
                        <TextBlock Style="{StaticResource chevron_text}" />
                    </Button>
                </StackPanel>
                <Button Style="{StaticResource toolbar_button}" Click="info_click"
                        ToolTip="{x:Static vm:STRINGS.toolbar_info}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource icon_text}" Text="&#xE946;" />
                    </StackPanel>
                </Button>
                <ToggleButton Style="{StaticResource toolbar_button}"
                              IsChecked="{Binding panel_open, Mode=TwoWay}"
                              ToolTip="{x:Static vm:STRINGS.toolbar_panel}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource icon_text}" Text="&#xE8A0;" />
                        <Border Margin="6,0,0,0" MinWidth="18" Height="18" Padding="5,0"
                                CornerRadius="9" Background="{DynamicResource accent_fill_brush}"
                                Visibility="{Binding shows_panel_badge,
                                    Converter={StaticResource visible_when}}">
                            <TextBlock Text="{Binding mods.enabled_count}" FontSize="11"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource accent_on_brush}" />
                        </Border>
                    </StackPanel>
                </ToggleButton>
            </StackPanel>

            <StackPanel x:Name="toolbar_left" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static vm:STRINGS.add_files}" InputGestureText=""
                                      Click="add_files_click" />
                            <MenuItem Header="{x:Static vm:STRINGS.add_folders}"
                                      Click="add_folders_click" />
                            <MenuItem Header="{x:Static vm:STRINGS.add_folder_contents}"
                                      Click="add_folder_contents_click" />
                        </ContextMenu>
                    </StackPanel.ContextMenu>
                    <Button Style="{StaticResource split_main_button}" Click="add_files_click"
                            ToolTip="{x:Static vm:STRINGS.toolbar_add}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource icon_text}" Text="&#xE710;" />
                            <TextBlock Style="{StaticResource toolbar_label}" Tag="label"
                                       Text="{x:Static vm:STRINGS.toolbar_add}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource split_drop_button}" Click="open_menu_click"
                            ToolTip="{x:Static vm:STRINGS.toolbar_add_menu}">
                        <TextBlock Style="{StaticResource chevron_text}" />
                    </Button>
                </StackPanel>
                <Button Style="{StaticResource toolbar_button}" Command="{Binding remove_command}"
                        ToolTip="{x:Static vm:STRINGS.toolbar_remove}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource icon_text}" Text="&#xE738;" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource toolbar_button}" Command="{Binding clear_command}"
                        ToolTip="{x:Static vm:STRINGS.toolbar_clear}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource icon_text}" Text="&#xE74D;" />
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource toolbar_separator}" />
                <Button Style="{StaticResource toolbar_button}" Command="{Binding undo_command}"
                        ToolTip="{x:Static vm:STRINGS.toolbar_undo}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource icon_text}" Text="&#xE7A7;" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource toolbar_button}" Command="{Binding redo_command}"
                        ToolTip="{x:Static vm:STRINGS.toolbar_redo}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource icon_text}" Text="&#xE7A6;" />
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource toolbar_separator}" />
                <Button Style="{StaticResource toolbar_button}" Click="open_own_menu_click"
                        ToolTip="{x:Static vm:STRINGS.toolbar_sort}">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="sort_menu" Opened="sort_menu_opened" />
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource icon_text}" Text="&#xE8CB;" />
                        <TextBlock Style="{StaticResource toolbar_label}" Tag="label"
                                   Text="{x:Static vm:STRINGS.toolbar_sort}" />
                        <TextBlock Style="{StaticResource chevron_text}" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Click="open_own_menu_click" ToolTip="{x:Static vm:STRINGS.toolbar_filter}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource toolbar_button}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding list.filter,
                                    Converter={StaticResource equals},
                                    ConverterParameter={x:Static vm:VIEW_FILTER.all}}"
                                             Value="False">
                                    <Setter Property="Background"
                                            Value="{DynamicResource accent_soft_brush}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource accent_text_brush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="filter_menu" Opened="filter_menu_opened" />
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource icon_text}" Text="&#xE71C;" />
                        <TextBlock Style="{StaticResource toolbar_label}" Tag="label"
                                   Text="{Binding list.filter_label}" />
                        <TextBlock Style="{StaticResource chevron_text}" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource toolbar_button}" Click="open_own_menu_click"
                        ToolTip="{x:Static vm:STRINGS.toolbar_columns}">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="columns_menu" Opened="columns_menu_opened" />
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource icon_text}" Text="&#xE8FD;" />
                        <TextBlock Style="{StaticResource toolbar_label}" Tag="label"
                                   Text="{x:Static vm:STRINGS.toolbar_columns}" />
                        <TextBlock Style="{StaticResource chevron_text}" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource toolbar_separator}" />
                <Button x:Name="duplicate_button" Click="duplicate_click"
                        ToolTip="{x:Static vm:STRINGS.toolbar_duplicate}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource toolbar_button}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding duplicate_enabled}" Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource accent_soft_brush}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource accent_text_brush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource icon_text}" Text="&#xE8C8;" />
                        <TextBlock Style="{StaticResource toolbar_label}" Tag="label"
                                   Text="{x:Static vm:STRINGS.toolbar_duplicate}" />
                        <TextBlock Style="{StaticResource chevron_text}" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Popup x:Name="duplicate_popup"
                       PlacementTarget="{Binding ElementName=duplicate_button}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                            BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,4,0,0"
                            MinWidth="260">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding duplicate_enabled, Mode=TwoWay}"
                                      Content="{x:Static vm:STRINGS.duplicate_on}"
                                      ToolTip="{x:Static vm:STRINGS.duplicate_on_tip}" />
                            <TextBlock Style="{StaticResource caption_text}"
                                       Text="{x:Static vm:STRINGS.duplicate_format_title}" />
                            <ComboBox ItemsSource="{StaticResource duplicate_formats}"
                                      DisplayMemberPath="label" SelectedValuePath="value"
                                      SelectedValue="{Binding duplicate_format, Mode=TwoWay}"
                                      IsEnabled="{Binding duplicate_enabled}" />
                            <TextBox Margin="0,6,0,0" MaxLength="32"
                                     Text="{Binding duplicate_custom_text, Mode=TwoWay,
                                         UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{x:Static vm:STRINGS.duplicate_custom_hint}"
                                     IsEnabled="{Binding duplicate_enabled}"
                                     Visibility="{Binding duplicate_is_custom,
                                         Converter={StaticResource visible_when}}" />
                            <TextBlock Style="{StaticResource caption_text}"
                                       Text="{x:Static vm:STRINGS.duplicate_mode_title}" />
                            <ComboBox ItemsSource="{StaticResource duplicate_modes}"
                                      DisplayMemberPath="label" SelectedValuePath="value"
                                      SelectedValue="{Binding duplicate_mode, Mode=TwoWay}"
                                      IsEnabled="{Binding duplicate_enabled}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </DockPanel>

        <Grid x:Name="content" Grid.Row="1" Margin="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition x:Name="splitter_column" Width="10" />
                <ColumnDefinition x:Name="panel_column" Width="360" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="44" Padding="12,0"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                        <TextBlock Text="{Binding list.header_text}" VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <Grid x:Name="list_host" />
                </DockPanel>
            </Border>

            <GridSplitter x:Name="splitter" Grid.Column="1" Width="10" Background="Transparent"
                          HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border Style="{StaticResource splitter_grip}" />
                        </Grid>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <Border x:Name="panel" Grid.Column="2" Style="{StaticResource card}"
                    Background="{DynamicResource LayerFillColorDefaultBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="44" Padding="12,0,8,0"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource toolbar_button}"
                                    Padding="7,0" ToolTip="{x:Static vm:STRINGS.panel_add}">
                                <TextBlock Style="{StaticResource icon_text}" Text="&#xE710;" />
                            </Button>
                            <TextBlock Text="{x:Static vm:STRINGS.panel_title}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Grid x:Name="panel_host" />
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="16,0,12,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding status.time_text}" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding status.message}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding status.progress_visible,
                            Converter={StaticResource visible_when}}">
                <TextBlock Text="{Binding status.progress_label}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding status.progress_text}" Margin="8,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ProgressBar Width="160" Height="4" Minimum="0" Maximum="1"
                             Value="{Binding status.progress_value, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0"
                        VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource toolbar_button}" Padding="8,0"
                              Command="{Binding status.toggle_error}"
                              Foreground="{DynamicResource status_error_brush}"
                              IsChecked="{Binding status.active_filter, Mode=OneWay,
                                  Converter={StaticResource equals},
                                  ConverterParameter={x:Static vm:VIEW_FILTER.error}}"
                              Visibility="{Binding status.has_errors,
                                  Converter={StaticResource visible_when}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource icon_text}" FontSize="14"
                                   Text="&#xEA39;" />
                        <TextBlock Margin="6,0,0,0" Text="{Binding status.error_text}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Style="{StaticResource toolbar_button}" Padding="8,0"
                              Command="{Binding status.toggle_conflict}"
                              Foreground="{DynamicResource status_conflict_brush}"
                              IsChecked="{Binding status.active_filter, Mode=OneWay,
                                  Converter={StaticResource equals},
                                  ConverterParameter={x:Static vm:VIEW_FILTER.conflict}}"
                              Visibility="{Binding status.has_conflicts,
                                  Converter={StaticResource visible_when}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource icon_text}" FontSize="14"
                                   Text="&#xE8AB;" />
                        <TextBlock Margin="6,0,0,0" Text="{Binding status.conflict_text}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Style="{StaticResource toolbar_button}" Padding="8,0"
                              Command="{Binding status.toggle_warning}"
                              Foreground="{DynamicResource status_warning_brush}"
                              IsChecked="{Binding status.active_filter, Mode=OneWay,
                                  Converter={StaticResource equals},
                                  ConverterParameter={x:Static vm:VIEW_FILTER.warning}}"
                              Visibility="{Binding status.has_warnings,
                                  Converter={StaticResource visible_when}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource icon_text}" FontSize="14"
                                   Text="&#xE7BA;" />
                        <TextBlock Margin="6,0,0,0" Text="{Binding status.warning_text}" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{x:Static vm:STRINGS.button_rename_undo}" Height="32"
                        Padding="14,0" Command="{Binding rename_undo_command}" />
                <Button Style="{StaticResource accent_button}" Margin="8,0,0,0"
                        Content="{x:Static vm:STRINGS.button_rename}"
                        Command="{Binding rename_command}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
