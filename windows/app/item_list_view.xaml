<UserControl x:Class="limenamer.ITEM_LIST_VIEW"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:limenamer;assembly=limenamer_view_model"
             AllowDrop="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="visible_when" />

        <Style x:Key="header_gripper" TargetType="Thumb">
            <Setter Property="Width" Value="8" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="column_header" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border Padding="8,0" Background="{TemplateBinding Background}"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding
                                                      HorizontalContentAlignment}" />
                            </Border>
                            <Border x:Name="separator" Width="1" Margin="0,9"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource
                                        DividerStrokeColorDefaultBrush}" />
                            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                                   Style="{StaticResource header_gripper}" />
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                                   Style="{StaticResource header_gripper}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="first">
                                <Setter TargetName="separator" Property="Visibility"
                                        Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="blank_header" TargetType="DataGridColumnHeader">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="Transparent" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="grip_text" TargetType="TextBlock" BasedOn="{StaticResource icon_text}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.list.can_drag,
                            RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver,
                            RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                   Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.list.can_drag,
                            RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True" />
                        <Condition Binding="{Binding IsSelected,
                            RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                   Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="row" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Grid>
                            <Border x:Name="back" Background="{TemplateBinding Background}"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                <DataGridCellsPresenter />
                            </Border>
                            <Border x:Name="bar" Width="3" Margin="3,9" CornerRadius="2"
                                    HorizontalAlignment="Left" Visibility="Collapsed"
                                    Background="{DynamicResource accent_text_brush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="back" Property="Background"
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="back" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding is_dimmed}" Value="True">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="cell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="8,0" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="tag" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="new_name_mark" TargetType="Run">
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding status}" Value="{x:Static vm:STATUS.ok}">
                    <Setter Property="Foreground" Value="{DynamicResource accent_text_brush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="new_name_text" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource name_font}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding status}" Value="{x:Static vm:STATUS.warning}">
                    <Setter Property="Foreground" Value="{DynamicResource status_warning_brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="{x:Static vm:STATUS.error}">
                    <Setter Property="Foreground" Value="{DynamicResource status_error_brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="{x:Static vm:STATUS.conflict}">
                    <Setter Property="Foreground"
                            Value="{DynamicResource status_conflict_brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="{x:Static vm:STATUS.unchanged}">
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="status_badge" TargetType="Border">
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="6,0,8,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource status_ok_back_brush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource status_ok_brush}" />
            <Setter Property="Tag" Value="&#xE73E;" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding status}" Value="{x:Static vm:STATUS.unchanged}">
                    <Setter Property="Background"
                            Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter Property="TextElement.Foreground"
                            Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Setter Property="Tag" Value="&#xE738;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="{x:Static vm:STATUS.warning}">
                    <Setter Property="Background"
                            Value="{DynamicResource status_warning_back_brush}" />
                    <Setter Property="TextElement.Foreground"
                            Value="{DynamicResource status_warning_brush}" />
                    <Setter Property="Tag" Value="&#xE7BA;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="{x:Static vm:STATUS.error}">
                    <Setter Property="Background"
                            Value="{DynamicResource status_error_back_brush}" />
                    <Setter Property="TextElement.Foreground"
                            Value="{DynamicResource status_error_brush}" />
                    <Setter Property="Tag" Value="&#xEA39;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="{x:Static vm:STATUS.conflict}">
                    <Setter Property="Background"
                            Value="{DynamicResource status_conflict_back_brush}" />
                    <Setter Property="TextElement.Foreground"
                            Value="{DynamicResource status_conflict_brush}" />
                    <Setter Property="Tag" Value="&#xE8AB;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="root">
        <DataGrid x:Name="grid" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False" CanUserResizeColumns="True"
                  HeadersVisibility="Column" SelectionMode="Extended" SelectionUnit="FullRow"
                  GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                  RowHeight="34" ColumnHeaderHeight="32" EnableRowVirtualization="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ColumnHeaderStyle="{StaticResource column_header}"
                  RowStyle="{StaticResource row}" CellStyle="{StaticResource cell}">
            <DataGrid.Columns>
                <DataGridTemplateColumn x:Name="check_column" Width="40" IsReadOnly="True"
                                        CanUserResize="False">
                    <DataGridTemplateColumn.Header>
                        <CheckBox x:Name="check_all_box" IsThreeState="True" MinWidth="0"
                                  ToolTip="{x:Static vm:STRINGS.check_all_tip}"
                                  IsChecked="{Binding DataContext.list.check_all_state,
                                      Mode=OneWay, RelativeSource={RelativeSource
                                      AncestorType=DataGrid}}"
                                  Click="check_all_click" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox MinWidth="0" IsChecked="{Binding is_checked, Mode=OneWay}"
                                      Click="check_click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:Name="index_column" Width="64" IsReadOnly="True"
                                        Header="{x:Static vm:STRINGS.column_index}">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader"
                               BasedOn="{StaticResource column_header}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding index}" HorizontalAlignment="Center"
                                       Style="{StaticResource secondary_text}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:Name="status_column" Width="108" IsReadOnly="True"
                                        Header="{x:Static vm:STRINGS.column_status}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource status_badge}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource icon_text}" FontSize="12"
                                               Text="{Binding Tag, RelativeSource={RelativeSource
                                                   AncestorType=Border}}" />
                                    <TextBlock Margin="4,0,0,0" FontSize="12"
                                               VerticalAlignment="Center"
                                               Text="{Binding status_text}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:Name="current_column" Width="*" MinWidth="120"
                                        IsReadOnly="True"
                                        Header="{x:Static vm:STRINGS.column_current}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel ToolTip="{Binding full_path}">
                                <Border DockPanel.Dock="Left" Style="{StaticResource tag}"
                                        Margin="0,0,6,0"
                                        Background="{DynamicResource folder_tag_back_brush}"
                                        Visibility="{Binding is_dir,
                                            Converter={StaticResource visible_when}}">
                                    <TextBlock Text="{x:Static vm:STRINGS.tag_folder}"
                                               FontSize="11"
                                               Foreground="{DynamicResource folder_tag_brush}" />
                                </Border>
                                <TextBlock Text="{Binding name}" VerticalAlignment="Center"
                                           FontFamily="{StaticResource name_font}"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource secondary_text}" />
                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:Name="new_column" Width="*" MinWidth="120"
                                        Header="{x:Static vm:STRINGS.column_new}">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader"
                               BasedOn="{StaticResource column_header}">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource accent_text_brush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource cell}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding changed}" Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource accent_column_brush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel Background="Transparent"
                                       ToolTip="{Binding problem_text}"
                                       ToolTipService.IsEnabled="{Binding has_problems}"
                                       MouseLeftButtonDown="new_name_mouse_down">
                                <Border DockPanel.Dock="Right" Style="{StaticResource tag}"
                                        Margin="6,0,0,0"
                                        Background="{DynamicResource accent_soft_brush}"
                                        Visibility="{Binding direct,
                                            Converter={StaticResource visible_when}}">
                                    <TextBlock Text="{x:Static vm:STRINGS.tag_direct}"
                                               FontSize="11"
                                               Foreground="{DynamicResource accent_text_brush}" />
                                </Border>
                                <TextBlock Style="{StaticResource new_name_text}"><Run
                                    Text="{Binding new_name_head, Mode=OneWay}" /><Run
                                    Text="{Binding new_name_mark, Mode=OneWay}"
                                    Style="{StaticResource new_name_mark}" /><Run
                                    Text="{Binding new_name_tail, Mode=OneWay}" /></TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding new_name, Mode=OneWay}" MinHeight="28"
                                     Padding="4,2" FontFamily="{StaticResource name_font}"
                                     Loaded="edit_box_loaded" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:Name="folder_column" Width="0.8*" MinWidth="80"
                                        IsReadOnly="True"
                                        Header="{x:Static vm:STRINGS.column_folder}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding folder}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding folder}"
                                       Style="{StaticResource secondary_text}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:Name="modified_column" Width="136" IsReadOnly="True"
                                        Header="{x:Static vm:STRINGS.column_modified}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding modified_text}" FontSize="12"
                                       Style="{StaticResource secondary_text}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:Name="created_column" Width="136" IsReadOnly="True"
                                        Header="{x:Static vm:STRINGS.column_created}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding created_text}" FontSize="12"
                                       Style="{StaticResource secondary_text}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:Name="size_column" Width="80" IsReadOnly="True"
                                        Header="{x:Static vm:STRINGS.column_size}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding size_text}" HorizontalAlignment="Right"
                                       FontSize="12"
                                       Style="{StaticResource secondary_text}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:Name="grip_column" Width="36" IsReadOnly="True"
                                        CanUserResize="False"
                                        HeaderStyle="{StaticResource blank_header}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="&#xE76F;" Background="Transparent" Cursor="SizeNS"
                                       HorizontalAlignment="Center"
                                       ToolTip="{x:Static vm:STRINGS.grip_tip}"
                                       Style="{StaticResource grip_text}"
                                       PreviewMouseLeftButtonDown="grip_mouse_down" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <DataGrid.ContextMenu>
                <ContextMenu x:Name="row_menu">
                    <MenuItem Header="{x:Static vm:STRINGS.row_direct_edit}" InputGestureText="F2"
                              Click="row_direct_edit_click" />
                    <MenuItem Header="{x:Static vm:STRINGS.row_remove}" InputGestureText="Delete"
                              Click="row_remove_click" />
                    <Separator />
                    <MenuItem Header="{x:Static vm:STRINGS.row_open_location}"
                              Click="row_open_location_click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <Canvas x:Name="drop_layer" IsHitTestVisible="False" Visibility="Collapsed">
            <Border x:Name="drop_line" Height="2" CornerRadius="1"
                    Background="{DynamicResource accent_text_brush}" />
            <Ellipse x:Name="drop_dot" Width="8" Height="8" StrokeThickness="2"
                     Stroke="{DynamicResource accent_text_brush}"
                     Fill="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
            <Border x:Name="drag_badge" CornerRadius="4" Padding="8,4" BorderThickness="1"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource icon_text}" FontSize="14" Text="&#xE8A5;"
                               Foreground="{DynamicResource accent_text_brush}" />
                    <TextBlock x:Name="drag_text" Margin="6,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource name_font}" />
                </StackPanel>
            </Border>
        </Canvas>

        <Grid x:Name="empty_layer">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320"
                        Visibility="{Binding list.shows_empty_list,
                            Converter={StaticResource visible_when}}">
                <TextBlock Style="{StaticResource icon_text}" FontSize="56" Text="&#xE8B7;"
                           HorizontalAlignment="Center" Opacity="0.55" />
                <TextBlock Margin="0,12,0,4" HorizontalAlignment="Center" FontSize="16"
                           FontWeight="SemiBold" Text="{x:Static vm:STRINGS.empty_list_title}" />
                <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{x:Static vm:STRINGS.empty_list_text}" />
                <Button Margin="0,14,0,0" HorizontalAlignment="Center" Padding="14,0" Height="32"
                        Content="{x:Static vm:STRINGS.toolbar_add}" Click="empty_add_click" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding list.shows_empty_filter,
                            Converter={StaticResource visible_when}}">
                <TextBlock Style="{StaticResource icon_text}" FontSize="40" Text="&#xE71C;"
                           HorizontalAlignment="Center" Opacity="0.55" />
                <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="16"
                           FontWeight="SemiBold" Text="{Binding list.empty_filter_title}" />
                <Button Margin="0,14,0,0" HorizontalAlignment="Center" Padding="14,0" Height="32"
                        Content="{x:Static vm:STRINGS.show_all}" Click="show_all_click" />
            </StackPanel>
        </Grid>

        <Border x:Name="drop_zone" Visibility="Collapsed" IsHitTestVisible="False" Margin="8"
                CornerRadius="8" BorderThickness="2"
                BorderBrush="{DynamicResource accent_text_brush}"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource icon_text}" FontSize="56" Text="&#xE896;"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource accent_text_brush}" />
                <TextBlock Margin="0,12,0,4" HorizontalAlignment="Center" FontSize="16"
                           FontWeight="SemiBold" Text="{x:Static vm:STRINGS.drop_title}" />
                <TextBlock HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{x:Static vm:STRINGS.drop_text}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
