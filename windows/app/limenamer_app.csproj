<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <AssemblyName>LimeNamer</AssemblyName>
        <ApplicationIcon>app.ico</ApplicationIcon>
        <RollForward>Major</RollForward>
        <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
        <NoWarn>$(NoWarn);WPF0001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Page Remove="app.xaml" />
        <ApplicationDefinition Include="app.xaml" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\view_model\limenamer_view_model.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="images\app_icon.png" />
        <Resource Include="images\profile.png" />
        <Resource Include="..\..\LICENSE" Link="licenses\limenamer.txt" />
        <Resource Include="..\..\licenses\nlohmann_json.txt" Link="licenses\nlohmann_json.txt" />
    </ItemGroup>
</Project>
