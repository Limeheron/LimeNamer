<Window x:Class="limenamer.INFO_WINDOW"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:limenamer;assembly=limenamer_view_model"
        Title="{x:Static vm:STRINGS.info_title}"
        Width="520"
        Height="560"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,16" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource accent_button}"
                        VerticalAlignment="Center" MinWidth="120" IsDefault="True"
                        IsCancel="True" Content="{x:Static vm:STRINGS.dialog_ok}"
                        Click="close_click" />
                <StackPanel Orientation="Horizontal">
                    <Image Width="48" Height="48" Source="images/profile.png"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Limeheron" FontWeight="SemiBold" />
                        <TextBlock>
                            <Hyperlink NavigateUri="https://github.com/Limeheron"
                                       RequestNavigate="link_navigate">
                                <Run Text="github.com/Limeheron" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Margin="24,16,24,16">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <Image Width="48" Height="48" Source="images/app_icon.png"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="LimeNamer" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="version_text" Style="{StaticResource secondary_text}" />
                </StackPanel>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Margin="0,18,0,6" FontWeight="SemiBold"
                       Text="{x:Static vm:STRINGS.info_notices}" />
            <Border CornerRadius="6" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="notices_text" Margin="12,8" TextWrapping="Wrap"
                               FontSize="12" />
                </ScrollViewer>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
