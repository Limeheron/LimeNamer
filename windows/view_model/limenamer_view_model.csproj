<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>limenamer_view_model</AssemblyName>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EngineBinDir Condition="'$(EngineBinDir)' == ''">$(MSBuildThisFileDirectory)..\..\engine\build\win-$(Configuration.ToLowerInvariant())\bin</EngineBinDir>
        <EngineDll>$([MSBuild]::EnsureTrailingSlash('$(EngineBinDir)'))limenamer_engine.dll</EngineDll>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="limenamer_tests" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="strings\strings.resx">
            <Generator>MSBuild:Compile</Generator>
            <ManifestResourceName>limenamer.STRINGS</ManifestResourceName>
            <StronglyTypedFileName>$(IntermediateOutputPath)strings.designer.cs</StronglyTypedFileName>
            <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
            <StronglyTypedNamespace>limenamer</StronglyTypedNamespace>
            <StronglyTypedClassName>STRINGS</StronglyTypedClassName>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <None Include="$(EngineDll)" Link="limenamer_engine.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>

    <Target Name="check_engine_dll" BeforeTargets="PrepareForBuild" Condition="!Exists('$(EngineDll)')">
        <Error Text="Engine DLL not found: $(EngineDll). Build the engine first." />
    </Target>
</Project>
